from tkinter import *
from tkinter import messagebox, simpledialog


# =====================
# MODELO
# =====================

class Cuenta:

    def __init__(self, numero, titular, pin, saldo):

        self.numero = numero
        self.titular = titular
        self.pin = pin
        self.saldo = saldo

    def depositar(self, monto):

        if monto > 0:

            self.saldo += monto

            return True

        return False

    def retirar(self, monto):

        if monto <= self.saldo:

            self.saldo -= monto

            return True

        return False


# =====================
# SISTEMA
# =====================

class Cajero:

    def __init__(self):

        self.cuentas = {

            "001":
            Cuenta(
                "001",
                "Juan Pérez",
                "1234",
                1000000
            ),

            "002":
            Cuenta(
                "002",
                "María García",
                "5678",
                2500000
            ),

            "003":
            Cuenta(
                "003",
                "Carlos López",
                "9999",
                800000
            )
        }

        self.actual = None

    def login(self, cuenta, pin):

        if cuenta in self.cuentas:

            u = self.cuentas[cuenta]

            if u.pin == pin:

                self.actual = u

                return True

        return False


# =====================
# INTERFAZ
# =====================

class Ventana:

    def __init__(self):

        self.cajero = Cajero()

        self.root = Tk()

        self.root.geometry("550x500")

        self.root.configure(
            bg="#06283D"
        )

        self.root.title(
            "🏦 Cajero Automático"
        )

        self.login()

        self.root.mainloop()

    def limpiar(self):

        for x in self.root.winfo_children():

            x.destroy()

    # LOGIN

    def login(self):

        self.limpiar()

        Label(
            self.root,
            text="🏦",
            bg="#06283D",
            fg="white",
            font=("Arial", 40)
        ).pack()

        Label(
            self.root,
            text="CAJERO AUTOMÁTICO",
            bg="#06283D",
            fg="white",
            font=("Arial", 20)
        ).pack()

        Label(
            self.root,
            text="Cuenta",
            bg="#06283D",
            fg="white"
        ).pack()

        self.ent_cuenta = Entry(
            self.root
        )

        self.ent_cuenta.pack()

        Label(
            self.root,
            text="PIN",
            bg="#06283D",
            fg="white"
        ).pack()

        self.ent_pin = Entry(
            self.root,
            show="*"
        )

        self.ent_pin.pack()

        Button(
            self.root,
            text="Ingresar",
            bg="#16A085",
            fg="white",
            command=self.ingresar
        ).pack(
            pady=20
        )

    def ingresar(self):

        if self.cajero.login(
            self.ent_cuenta.get(),
            self.ent_pin.get()
        ):

            self.menu()

        else:

            messagebox.showerror(
                "Error",
                "Cuenta o PIN incorrectos"
            )

    # MENU

    def menu(self):

        self.limpiar()

        u = self.cajero.actual

        Label(
            self.root,
            text=f"Bienvenido\n{u.titular}",
            bg="#06283D",
            fg="white",
            font=("Arial", 18)
        ).pack(
            pady=20
        )

        self.lbl = Label(

            self.root,

            text="Saldo oculto",

            bg="white",

            font=("Arial", 20),

            width=15

        )

        self.lbl.pack()

        Button(

            self.root,

            text="Consultar",

            width=20,

            bg="#27AE60",

            fg="white",

            command=self.consultar

        ).pack(pady=10)

        Button(

            self.root,

            text="Depositar",

            width=20,

            bg="#3498DB",

            fg="white",

            command=self.depositar

        ).pack(pady=10)

        Button(

            self.root,

            text="Retirar",

            width=20,

            bg="#F39C12",

            fg="white",

            command=self.retirar

        ).pack(pady=10)

        Button(

            self.root,

            text="Cerrar sesión",

            width=20,

            bg="#E74C3C",

            fg="white",

            command=self.login

        ).pack(pady=25)

    def consultar(self):

        self.lbl.config(

            text=f"${self.cajero.actual.saldo:,.0f}"

        )

    def depositar(self):

        monto = simpledialog.askfloat(

            "Depósito",

            "Ingrese valor"

        )

        if monto:

            self.cajero.actual.depositar(

                monto

            )

            self.consultar()

    def retirar(self):

        monto = simpledialog.askfloat(

            "Retiro",

            "Ingrese valor"

        )

        if monto:

            if self.cajero.actual.retirar(

                monto

            ):

                self.consultar()

            else:

                messagebox.showerror(

                    "Error",

                    "Saldo insuficiente"

                )


Ventana()